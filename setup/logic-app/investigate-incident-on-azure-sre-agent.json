{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "workflowName": {
      "type": "string",
      "defaultValue": "InvestigateIncidentOnAzureSREAgent",
      "metadata": {
        "description": "Name of the Logic App Consumption workflow."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure region for the Logic App and Microsoft Sentinel API connection."
      }
    },
    "sentinelConnectionName": {
      "type": "string",
      "defaultValue": "[concat('azuresentinel-', parameters('workflowName'))]",
      "metadata": {
        "description": "Name of the managed Microsoft Sentinel API connection."
      }
    },
    "sreAgentTriggerUrl": {
      "type": "string",
      "metadata": {
        "description": "Full authenticated HTTP trigger URL exposed by the target Azure SRE Agent."
      }
    },
    "sreAgentAudience": {
      "type": "string",
      "defaultValue": "59f0a04a-b322-4310-adc9-39ac41e9631e",
      "metadata": {
        "description": "Microsoft Entra audience used to authenticate calls to Azure SRE Agent."
      }
    },
    "sreAgentResourceGroupResourceId": {
      "type": "string",
      "metadata": {
        "description": "Resource ID of the resource group that contains the target Azure SRE Agent."
      }
    },
    "assignSreAgentRole": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "Assign SRE Agent Standard User to the workflow system-assigned identity on the SRE Agent resource group."
      }
    },
    "sreAgentStandardUserRoleDefinitionId": {
      "type": "string",
      "defaultValue": "2d84a65a-63b2-4343-bbb6-31105d857bc1",
      "metadata": {
        "description": "Role definition GUID for the built-in SRE Agent Standard User role."
      }
    },
    "assignSentinelAutomationRole": {
      "type": "bool",
      "defaultValue": false,
      "metadata": {
        "description": "Assign Microsoft Sentinel Automation Contributor on the workflow resource group to a supplied Sentinel automation principal."
      }
    },
    "sentinelAutomationPrincipalId": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Tenant-specific object ID of the Microsoft Sentinel automation service principal. Required only when assignSentinelAutomationRole is true."
      }
    },
    "sentinelAutomationContributorRoleDefinitionId": {
      "type": "string",
      "defaultValue": "f4c81013-99ee-4d62-a7ee-b3f1f648599a",
      "metadata": {
        "description": "Role definition GUID for the built-in Microsoft Sentinel Automation Contributor role."
      }
    },
    "tags": {
      "type": "object",
      "defaultValue": {},
      "metadata": {
        "description": "Tags applied to the workflow and API connection."
      }
    }
  },
  "variables": {
    "sentinelManagedApiId": "[subscriptionResourceId('Microsoft.Web/locations/managedApis', parameters('location'), 'azuresentinel')]",
    "sreAgentRoleDefinitionResourceId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', parameters('sreAgentStandardUserRoleDefinitionId'))]",
    "sentinelAutomationRoleDefinitionResourceId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', parameters('sentinelAutomationContributorRoleDefinitionId'))]"
  },
  "resources": [
    {
      "type": "Microsoft.Web/connections",
      "apiVersion": "2016-06-01",
      "name": "[parameters('sentinelConnectionName')]",
      "location": "[parameters('location')]",
      "kind": "V1",
      "tags": "[parameters('tags')]",
      "properties": {
        "displayName": "[parameters('sentinelConnectionName')]",
        "parameterValueType": "Alternative",
        "api": {
          "id": "[variables('sentinelManagedApiId')]"
        }
      }
    },
    {
      "type": "Microsoft.Logic/workflows",
      "apiVersion": "2019-05-01",
      "name": "[parameters('workflowName')]",
      "location": "[parameters('location')]",
      "identity": {
        "type": "SystemAssigned"
      },
      "tags": "[parameters('tags')]",
      "dependsOn": [
        "[resourceId('Microsoft.Web/connections', parameters('sentinelConnectionName'))]"
      ],
      "properties": {
        "state": "Enabled",
        "definition": {
          "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "$connections": {
              "defaultValue": {},
              "type": "Object"
            }
          },
          "triggers": {
            "Microsoft_Sentinel_incident": {
              "type": "ApiConnectionWebhook",
              "inputs": {
                "body": {
                  "callback_url": "@{listCallbackUrl()}"
                },
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                  }
                },
                "path": "/incident-creation"
              }
            }
          },
          "actions": {
            "CreateHttpBody": {
              "type": "Compose",
              "inputs": "@triggerBody()?['object']?['properties']?['providerIncidentId']",
              "runAfter": {}
            },
            "HTTP": {
              "type": "Http",
              "inputs": {
                "uri": "[parameters('sreAgentTriggerUrl')]",
                "method": "POST",
                "authentication": {
                  "type": "ManagedServiceIdentity",
                  "audience": "[parameters('sreAgentAudience')]"
                },
                "body": {
                  "user_email": "@{outputs('CreateHttpBody')}"
                }
              },
              "runAfter": {
                "CreateHttpBody": [
                  "Succeeded"
                ]
              },
              "runtimeConfiguration": {
                "contentTransfer": {
                  "transferMode": "Chunked"
                }
              }
            },
            "ReadResponse": {
              "type": "Compose",
              "inputs": "@outputs('HTTP')?['statusCode']",
              "runAfter": {
                "HTTP": [
                  "Succeeded"
                ]
              }
            }
          },
          "outputs": {},
          "metadata": {
            "notes": {}
          }
        },
        "parameters": {
          "$connections": {
            "value": {
              "azuresentinel": {
                "id": "[variables('sentinelManagedApiId')]",
                "connectionId": "[resourceId('Microsoft.Web/connections', parameters('sentinelConnectionName'))]",
                "connectionName": "[parameters('sentinelConnectionName')]",
                "connectionProperties": {
                  "authentication": {
                    "type": "ManagedServiceIdentity"
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "condition": "[parameters('assignSreAgentRole')]",
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[parameters('sreAgentResourceGroupResourceId')]",
      "name": "[guid(parameters('sreAgentResourceGroupResourceId'), variables('sreAgentRoleDefinitionResourceId'), resourceId('Microsoft.Logic/workflows', parameters('workflowName')))]",
      "dependsOn": [
        "[resourceId('Microsoft.Logic/workflows', parameters('workflowName'))]"
      ],
      "properties": {
        "roleDefinitionId": "[variables('sreAgentRoleDefinitionResourceId')]",
        "principalId": "[reference(resourceId('Microsoft.Logic/workflows', parameters('workflowName')), '2019-05-01', 'Full').identity.principalId]",
        "principalType": "ServicePrincipal"
      }
    },
    {
      "condition": "[and(parameters('assignSentinelAutomationRole'), not(empty(parameters('sentinelAutomationPrincipalId'))))]",
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[guid(resourceGroup().id, variables('sentinelAutomationRoleDefinitionResourceId'), parameters('sentinelAutomationPrincipalId'))]",
      "properties": {
        "roleDefinitionId": "[variables('sentinelAutomationRoleDefinitionResourceId')]",
        "principalId": "[parameters('sentinelAutomationPrincipalId')]",
        "principalType": "ServicePrincipal"
      }
    }
  ],
  "outputs": {
    "workflowResourceId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Logic/workflows', parameters('workflowName'))]"
    },
    "workflowPrincipalId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Logic/workflows', parameters('workflowName')), '2019-05-01', 'Full').identity.principalId]"
    },
    "sentinelConnectionResourceId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Web/connections', parameters('sentinelConnectionName'))]"
    }
  }
}