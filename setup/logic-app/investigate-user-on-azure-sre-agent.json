{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "sreAgentTriggerUrl": {
      "type": "string",
      "metadata": {
        "description": "Full authenticated HTTP trigger URL exposed by the target Azure SRE Agent."
      }
    }
  },
  "variables": {
    "workflowName": "InvestigateUserOnAzureSREAgent",
    "location": "[resourceGroup().location]",
    "sentinelConnectionName": "azuresentinel-InvestigateUserOnAzureSREAgent",
    "sreAgentAudience": "59f0a04a-b322-4310-adc9-39ac41e9631e",
    "sreAgentStandardUserRoleDefinitionId": "2d84a65a-63b2-4343-bbb6-31105d857bc1",
    "sentinelManagedApiId": "[subscriptionResourceId('Microsoft.Web/locations/managedApis', variables('location'), 'azuresentinel')]",
    "sreAgentRoleDefinitionResourceId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('sreAgentStandardUserRoleDefinitionId'))]"
  },
  "resources": [
    {
      "type": "Microsoft.Web/connections",
      "apiVersion": "2016-06-01",
      "name": "[variables('sentinelConnectionName')]",
      "location": "[variables('location')]",
      "kind": "V1",
      "properties": {
        "displayName": "[variables('sentinelConnectionName')]",
        "parameterValueType": "Alternative",
        "api": {
          "id": "[variables('sentinelManagedApiId')]"
        }
      }
    },
    {
      "type": "Microsoft.Logic/workflows",
      "apiVersion": "2019-05-01",
      "name": "[variables('workflowName')]",
      "location": "[variables('location')]",
      "identity": {
        "type": "SystemAssigned"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/connections', variables('sentinelConnectionName'))]"
      ],
      "properties": {
        "state": "Enabled",
        "definition": {
          "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "$connections": {
              "defaultValue": {},
              "type": "Object"
            }
          },
          "triggers": {
            "Microsoft_Sentinel_entity": {
              "type": "ApiConnectionWebhook",
              "inputs": {
                "body": {
                  "callback_url": "@{listCallbackUrl()}"
                },
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                  }
                },
                "path": "/entity/@{encodeURIComponent('Account')}"
              }
            }
          },
          "actions": {
            "CreateHttpBody": {
              "type": "Compose",
              "inputs": "@concat(triggerBody()?['Entity']?['properties']?['Name'],'@',triggerBody()?['Entity']?['properties']?['UPNSuffix'])",
              "runAfter": {}
            },
            "HTTP": {
              "type": "Http",
              "inputs": {
                "uri": "[parameters('sreAgentTriggerUrl')]",
                "method": "POST",
                "authentication": {
                  "type": "ManagedServiceIdentity",
                  "audience": "[variables('sreAgentAudience')]"
                },
                "body": {
                  "user_email": "@{outputs('CreateHttpBody')}"
                }
              },
              "runAfter": {
                "CreateHttpBody": [
                  "Succeeded"
                ]
              },
              "runtimeConfiguration": {
                "contentTransfer": {
                  "transferMode": "Chunked"
                }
              }
            },
            "ReadResponse": {
              "type": "Compose",
              "inputs": "@outputs('HTTP')?['statusCode']",
              "runAfter": {
                "HTTP": [
                  "Succeeded"
                ]
              }
            }
          },
          "outputs": {},
          "metadata": {
            "notes": {}
          }
        },
        "parameters": {
          "$connections": {
            "value": {
              "azuresentinel": {
                "id": "[variables('sentinelManagedApiId')]",
                "connectionId": "[resourceId('Microsoft.Web/connections', variables('sentinelConnectionName'))]",
                "connectionName": "[variables('sentinelConnectionName')]",
                "connectionProperties": {
                  "authentication": {
                    "type": "ManagedServiceIdentity"
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[guid(resourceGroup().id, variables('sreAgentRoleDefinitionResourceId'), resourceId('Microsoft.Logic/workflows', variables('workflowName')))]",
      "dependsOn": [
        "[resourceId('Microsoft.Logic/workflows', variables('workflowName'))]"
      ],
      "properties": {
        "roleDefinitionId": "[variables('sreAgentRoleDefinitionResourceId')]",
        "principalId": "[reference(resourceId('Microsoft.Logic/workflows', variables('workflowName')), '2019-05-01', 'Full').identity.principalId]",
        "principalType": "ServicePrincipal"
      }
    }
  ],
  "outputs": {
    "workflowResourceId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Logic/workflows', variables('workflowName'))]"
    },
    "workflowPrincipalId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Logic/workflows', variables('workflowName')), '2019-05-01', 'Full').identity.principalId]"
    },
    "sentinelConnectionResourceId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Web/connections', variables('sentinelConnectionName'))]"
    }
  }
}